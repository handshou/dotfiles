diff --git a/scripts/agents.sh b/scripts/agents.sh
index ff15034..9258dd0 100755
--- a/scripts/agents.sh
+++ b/scripts/agents.sh
@@ -17,6 +17,32 @@ DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
 # shellcheck source=helpers.sh
 . "$DIR/helpers.sh"
 
+# Shared status-bar window labeller — returns "[PR#]" for a branch with an open
+# GitHub PR, otherwise "[m]"/folder-name/empty. We treat a numeric "[123]" as a
+# PR and fall back to the tmux window name for everything else.
+WINDOW_TITLE_SH="$(get_tmux_option @claude_window_title_script "$HOME/.config/tmux/window-title.sh")"
+
+# session_title <pane-path> <pane-id>
+# Title shown in the picker's last column:
+#   - "<repo> [PR#]" when the branch has an open PR (e.g. "se-mono [568]")
+#   - the pane's tmux window name otherwise (falling back to the folder name)
+session_title() {
+  local path="$1" pane="$2" pr repo wname
+  pr=$("$WINDOW_TITLE_SH" "$path" 2>/dev/null)
+  if [[ "$pr" =~ ^\[[0-9]+\]$ ]]; then
+    repo=$(cd "$path" 2>/dev/null && {
+      c=$(git rev-parse --git-common-dir 2>/dev/null) || exit
+      [[ "$c" != /* ]] && c="$PWD/$c"
+      basename "$(dirname "$c")"
+    })
+    if [ -n "$repo" ]; then printf '%s %s' "$repo" "$pr"; else printf '%s' "$pr"; fi
+  else
+    wname=$(tmux display-message -p -t "$pane" '#{window_name}' 2>/dev/null)
+    [ -z "$wname" ] && wname=$(basename "$path")
+    printf '%s' "$wname"
+  fi
+}
+
 agents="$(claude agents --json 2>/dev/null)" || exit 0
 rows="$(printf '%s' "$agents" |
   jq -r '.[] | select(.kind == "interactive") | [.pid, .status, .sessionId, .cwd] | @tsv' 2>/dev/null)"
@@ -57,7 +83,13 @@ done)"
     printf "%s\t%s\t%s\t%s\t%s\t%5s\t%s\t%s\n",
       rank, pane[tty], $2, kind, icon, age, loc[tty], path
   }
-' | sort -t$'\t' -k1,1n -k6,6n
+' | sort -t$'\t' -k1,1n -k6,6n |
+  while IFS=$'\t' read -r rank pane pid kind icon age loc path; do
+    # Swap the raw path for a human title (repo + PR number, or window name).
+    title=$(session_title "${path/#\~/$HOME}" "$pane")
+    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
+      "$rank" "$pane" "$pid" "$kind" "$icon" "$age" "$loc" "$title"
+  done
 # rank asc (what needs you floats up), then age asc so whatever just went idle
 # sits at the top of its group. -k6,6n reads the leading number of the age field
 # ("5m" -> 5; "-" -> 0).
