{
  "lastChangelogVersion": "1.4.0",
  "defaultProvider": "omlx",
  "defaultModel": "Qwen3.8-27B-8bit",
  "enabledModels": [
    "openai-codex/gpt-6.1-sol",
    "openai-codex/gpt-6-astra",
    "openai-codex/gpt-6-luna"
  ],
  "defaultThinkingLevel": "medium",
  "compaction": {
    "enabled": true,
    "reserveTokens": 8192,
    "keepRecentTokens": 8192
  },
  "packages": [
    "npm:@plannotator/pi-extension",
    "npm:pi-extmgr",
    "git:github.com/dmmulroy/pi-web-tools",
    "npm:pi-multimodal-proxy",
    "npm:@narumitw/pi-usage",
    "npm:@earendil-works/pi-voice"
  ],
  "theme": "catppuccin-macchiato",
  "enableSkillCommands": true,
  "defaultProjectTrust": "never",
  "extensions": [
    "!**",
    "../base/extensions/continue-after-compaction.ts", "+../base/extensions/continue-after-compaction.ts",
    "../base/extensions/git-interceptor.ts", "+../base/extensions/git-interceptor.ts",
    "../base/extensions/whimsical.ts", "+../base/extensions/whimsical.ts",
    "../base/extensions/handoff/index.ts", "+../base/extensions/handoff/index.ts",
    "../base/extensions/pi-cloak/index.ts", "+../base/extensions/pi-cloak/index.ts",
    "../base/extensions/mcp-read-only/index.ts", "+../base/extensions/mcp-read-only/index.ts",
    "../base/extensions/save-md/index.ts", "+../base/extensions/save-md/index.ts",
    "../base/extensions/pi-worktrees/src/index.ts", "+../base/extensions/pi-worktrees/src/index.ts",
    "../base/extensions/pi-skill-toggle/src/index.ts", "+../base/extensions/pi-skill-toggle/src/index.ts"
  ],
  "quietStartup": false,
  "steeringMode": "all",
  "followUpMode": "all",
  "treeFilterMode": "no-tools"
}