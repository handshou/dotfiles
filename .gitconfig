[user]
	name = handshou
	email = handshou@users.noreply.github.com
	signingkey = ~/.ssh/id_ed25519.pub
[github]
	user = handshou
[credential]
	helper = osxkeychain
[gpg]
	format = ssh
[commit]
	gpgsign = true
[tag]
	gpgsign = true
[alias]
	clone-for-worktrees = "!sh $HOME/scripts/git-clone-bare-for-worktrees.sh"
[gpg "ssh"]
	allowedSignersFile = /Users/h/.ssh/allowed_signers
[core]
	sshCommand = ssh -F ~/.config/git/ssh-personal
[credential "https://github.com"]
	username = handshou
	helper =
	helper = !env -u GH_TOKEN -u GITHUB_TOKEN GH_CONFIG_DIR=/Users/h/.config/gh-personal /opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	username = handshou
	helper =
	helper = !env -u GH_TOKEN -u GITHUB_TOKEN GH_CONFIG_DIR=/Users/h/.config/gh-personal /opt/homebrew/bin/gh auth git-credential
[includeIf "gitdir:~/Code/work/"]
	path = ~/.config/git/work
